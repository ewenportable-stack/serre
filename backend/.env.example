# Copier ce fichier en .env et ajuster les valeurs pour votre déploiement.

# Base SQLite (configuration de la serre)
DATABASE_PATH=serre.db

# Broker MQTT (Mosquitto)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=serre-backend

# InfluxDB (historique des mesures)
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=
INFLUX_ORG=serre
INFLUX_BUCKET=serre

# Origines autorisées à appeler l'API depuis le navigateur (séparées par des virgules dans .env,
# ou liste JSON — pydantic-settings accepte les deux formats pour un champ list[str])
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]
